<odoo>
  <record id="view_lre_export_wizard_form" model="ir.ui.view">
    <field name="name">lre.export.wizard.form</field>
    <field name="model">lre.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Exportar Libro de Remuneraciones (DT)">
        <group>
          <field name="company_id" invisible="1"/>
          <group>
            <field name="year"/>
            <field name="month"/>
            <field name="report_type" widget="radio"/>
          </group>
        </group>
        <footer>
          <button string="Generar LRE" type="object" name="action_generate_lre" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
