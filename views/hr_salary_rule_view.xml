<odoo>
    <data>
        <record id="view_hr_salary_rule_form_lre" model="ir.ui.view">
            <field name="name">hr.salary.rule.form.lre</field>
            <field name="model">hr.salary.rule</field>
            <field name="inherit_id" ref="om_hr_payroll.hr_salary_rule_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="lre_code"/>
                    <field name="lre_previred_code"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
