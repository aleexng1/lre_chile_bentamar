<odoo>
  <!-- Acción -->
  <record id="action_lre_iu_table_period" model="ir.actions.act_window">
    <field name="name">Impuesto Único (por Año/Mes)</field>
    <field name="res_model">lre.iu_table_period</field>
    <field name="view_mode">list,form</field>
    <field name="context">{}</field>
  </record>

  <!-- Menú dentro de LRE Chile -->
  <menuitem id="menu_lre_iu_root"
            name="Impuesto Único"
            parent="menu_l10n_cl_config"
            action="action_lre_iu_table_period"
            sequence="20"/>

  <!-- Lista -->
    <record id="view_lre_iu_table_period_list" model="ir.ui.view">
    <field name="name">lre.iu_table_period.list</field>
    <field name="model">lre.iu_table_period</field>
    <field name="arch" type="xml">
        <list>
        <field name="name"/>
        <field name="year"/>
        <field name="month"/>
        <field name="currency_id"/>
        <field name="notes"/>
        </list>
    </field>
    </record>


  <!-- Formulario -->
  <record id="view_lre_iu_table_period_form" model="ir.ui.view">
    <field name="name">lre.iu_table_period.form</field>
    <field name="model">lre.iu_table_period</field>
    <field name="arch" type="xml">
      <form string="Impuesto Único por Año/Mes">
        <sheet>
          <group>
            <field name="year"/>
            <field name="month"/>
            <field name="currency_id"/>
            <field name="name" readonly="1"/>
          </group>
          <group>
            <field name="notes" placeholder="Notas opcionales..."/>
          </group>
          <notebook>
            <page string="Tramos">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="sequence"/>
                  <field name="base_from_amount"/>
                  <field name="base_to_amount"/>
                  <field name="factor"/>
                  <field name="rate_percent"/>
                  <field name="rebate_amount"/>
                  <field name="active"/>
                </list>
                <form>
                  <group>
                    <field name="sequence"/>
                    <field name="base_from_amount"/>
                    <field name="base_to_amount"/>
                    <field name="rate_percent"/>
                    <field name="rebate_amount"/>
                    <field name="active"/>
                  </group>
                </form>
              </field>
            </page>
          </notebook>
        </sheet>
        <footer>
          <button string="Guardar" type="object" class="btn-primary" name="write"/>
          <button string="Cerrar" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>