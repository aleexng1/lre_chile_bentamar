<odoo>
    <data>
        <record id="view_company_form_lre" model="ir.ui.view">
            <field name="name">res.company.form.lre</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Nómina Chile" name="lre_chile_payroll">
                        <group>
                            <group string="Mutual de Seguridad">
                                <field name="lre_mutual_rate"/>
                                <field name="lre_mutual_code"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
